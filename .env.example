# Copy to .env and fill in. Never commit a real .env.

# Runtime
NODE_ENV=production
PORT=8080

# Public URL used to build sign-in links (no trailing slash)
PUBLIC_BASE_URL=https://staging.example

# Database
DATABASE_URL=postgres://app:app@db:5432/askliving

# Sessions (long random string; used to sign the session cookie)
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_DAYS=30

# Magic links
MAGIC_LINK_TTL_MIN=15

# Email delivery (central Mailer). When INTERNAL_SERVICE_KEY is empty in dev,
# the sign-in link is printed to the server log instead of emailed.
MAILER_URL=http://central-mailer-prod-api:8000/send
INTERNAL_SERVICE_KEY=
MAIL_FROM_NAME=Ask the Living

# Error tracking (optional; inert when empty)
SENTRY_DSN=

# Analytics (optional; inert when empty)
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Demo seed (1 loads sample data on first boot; used on staging only)
SEED_DEMO=0

# Follow-up questions (optional). Users turn this on per account by adding their
# own model key in Settings. The values below only power an owner-granted tier.
# Key material for encrypting stored user keys (falls back to SESSION_SECRET)
LLM_CRED_SECRET=
# Owner-granted gateway tier (all optional; the app works without them)
LLM_GATEWAY_URL=
LLM_API_KEY=
# Catalog model id for the gateway tier (claude-haiku, claude-sonnet, gpt-4o, ...)
LLM_GATEWAY_MODEL=claude-haiku
# Comma-separated emails the owner grants the gateway tier to
LLM_GATEWAY_ALLOW_EMAILS=
