{
  "name": "ask-the-living",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "node backend/dist/server.js",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "test": "npm run test --workspace backend",
    "test:e2e": "playwright test",
    "copy-sweep": "node scripts/copy-sweep.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "concurrently": "^9.1.0"
  }
}
